<Window x:Class="OfflineAgent.UI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Required" Height="180" Width="400"
        Background="#181818" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" Text="Nhập dữ liệu:" FontSize="13" Foreground="#888888" Margin="0,0,0,10"/>
        
        <TextBox Grid.Row="1" x:Name="InputTextBox" VerticalAlignment="Center" Height="28" 
                 Background="#252526" Foreground="White" BorderBrush="#3F3F3F" BorderThickness="1" 
                 Padding="5,2" CaretBrush="White" KeyDown="InputTextBox_KeyDown"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Hủy bỏ" Click="OnCancelClick" Background="#2D2D2D" Foreground="#E0E0E0" BorderThickness="1" BorderBrush="#3F3F3F" Width="80" Margin="0,0,10,0"/>
            <Button Content="Xác nhận" Click="OnOkClick" Background="#107C41" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
