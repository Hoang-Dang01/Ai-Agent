<Window x:Class="OfflineAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfflineAgent.UI"
        mc:Ignorable="d"
        Title="Knowledge-Work-Plugins Visual Designer" Height="680" Width="1100"
        Background="#121212" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    
    <Window.Resources>
        <!-- Custom Styles to create a Dark Vibe UI -->
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#3D1A1A"/>
            <Setter Property="Foreground" Value="#FF9999"/>
            <Setter Property="BorderBrush" Value="#5C2626"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#2D2D2D"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Area -->
            <RowDefinition Height="60"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛠️" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock Text="KNOWLEDGE WORK PLUGINS DESIGNER" FontSize="18" FontWeight="Bold" Foreground="#007ACC" VerticalAlignment="Center"/>
                    <TextBlock Text=" - OFFLINE AGENT SUITE" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tải lại danh sách" Click="OnReloadPluginsClick" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                    <Button Content="+ Tạo Phòng ban mới" Click="OnCreateNewPluginClick" Background="#107C41"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Workspace Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar: Plugins List -->
                <ColumnDefinition Width="300"/>
                <!-- Splitter -->
                <ColumnDefinition Width="1"/>
                <!-- Workspace detail pane -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#181818" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DANH SÁCH PHÒNG BAN" FontSize="12" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,10"/>
                    
                    <ListBox Grid.Row="1" x:Name="PluginsListBox" SelectionChanged="OnPluginSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Manifest.Name}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Manifest.Id}" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Text="Đang tìm tệp tin..." FontSize="11" Foreground="#666666" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Splitter Line -->
            <Rectangle Grid.Column="1" Fill="#2D2D2D" HorizontalAlignment="Stretch"/>

            <!-- Workspace details -->
            <Grid Grid.Column="2" x:Name="DetailGrid">
                <!-- Fallback empty view -->
                <Grid x:Name="EmptyStateGrid" Background="#121212" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                        <TextBlock Text="📂" FontSize="48" Margin="0,0,0,15"/>
                        <TextBlock Text="Không có phòng ban nào được chọn" FontSize="16" FontWeight="SemiBold" Foreground="#888888"/>
                        <TextBlock Text="Vui lòng chọn một phòng ban bên trái hoặc bấm nút tạo mới phía trên." FontSize="12" Foreground="#666666" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Active plugin workspace view -->
                <Grid x:Name="PluginWorkspaceGrid" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Active Plugin Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ActivePluginTitle" Text="Engineering Department" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="ActivePluginPath" Text="c:\path\to\plugin" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Lắp ghép &amp; Xem thử Prompt" Click="OnPreviewPromptClick" Background="#512BD4" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Tabs Area -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,5,0,0">
                        <TabControl.Resources>
                            <!-- Tab Styling -->
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="15,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0">
                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                                    <Setter Property="Foreground" Value="#007ACC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- Tab 1: Manifest Configuration -->
                        <TabItem Header="Thông tin chung">
                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ID (Read-only for safety) -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ID Phòng ban:" VerticalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="PluginIdTextBox" IsReadOnly="True" Background="#1A1A1C" Foreground="#888888" Margin="0,0,0,15"/>

                                    <!-- Name -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên hiển thị:" VerticalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="PluginNameTextBox" Margin="0,0,0,15"/>

                                    <!-- Version -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Phiên bản:" VerticalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PluginVersionTextBox" Margin="0,0,0,15"/>

                                    <!-- Icon -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Biểu tượng (Icon):" VerticalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="PluginIconTextBox" Margin="0,0,0,15"/>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Mô tả chức năng:" VerticalAlignment="Top" Margin="0,5,0,15"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="PluginDescTextBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                                    <!-- Save Button -->
                                    <Button Grid.Row="6" Grid.Column="1" Content="Lưu Cấu Hình Chung" Click="OnSaveManifestClick" Background="#107C41" Width="180" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- Tab 2: Skills (Markdown Files) -->
                        <TabItem Header="Hướng dẫn kỹ năng (Skills)">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <!-- Skills List -->
                                    <ColumnDefinition Width="220"/>
                                    <!-- Splitter -->
                                    <ColumnDefinition Width="15"/>
                                    <!-- Skill Editor -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Skills list -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox Grid.Row="0" x:Name="SkillsListBox" SelectionChanged="OnSkillSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📄" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Row="1" Content="+ Thêm Kỹ Năng" Click="OnAddNewSkillClick" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}"/>
                                </Grid>

                                <!-- Skill Editor -->
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <Grid x:Name="SkillEditorGrid" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Tên file kỹ năng:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox Grid.Column="1" x:Name="SkillNameTextBox"/>
                                            <Button Grid.Column="2" Content="Xóa Kỹ Năng" Click="OnDeleteSkillClick" Style="{StaticResource DangerButton}" Margin="10,0,0,0"/>
                                        </Grid>

                                        <TextBox Grid.Row="1" x:Name="SkillContentTextBox" TextWrapping="Wrap" AcceptsReturn="True" 
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas" FontSize="13" Background="#1E1E1E" BorderBrush="#333333" Margin="0,5,0,10"/>

                                        <Button Grid.Row="2" Content="Lưu File Kỹ Năng" Click="OnSaveSkillClick" Background="#107C41" Width="150" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- Tab 3: Commands -->
                        <TabItem Header="Lệnh tác nghiệp (Commands)">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox Grid.Row="0" x:Name="CommandsListBox" SelectionChanged="OnCommandSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#888888" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Row="1" Content="+ Đăng ký Lệnh mới" Click="OnAddNewCommandClick" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}"/>
                                </Grid>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <Grid x:Name="CommandEditorGrid" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Command Name & Delete -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Cú pháp Lệnh (Slash):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox Grid.Column="1" x:Name="CommandNameTextBox"/>
                                            <Button Grid.Column="2" Content="Xóa Lệnh" Click="OnDeleteCommandClick" Style="{StaticResource DangerButton}" Margin="10,0,0,0"/>
                                        </Grid>

                                        <!-- Command Description -->
                                        <Grid Grid.Row="1" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Mô tả công việc:" VerticalAlignment="Center" Margin="0,0,10,0" Width="105"/>
                                            <TextBox Grid.Column="1" x:Name="CommandDescTextBox"/>
                                        </Grid>

                                        <!-- Prompt -->
                                        <Grid Grid.Row="2" Margin="0,5,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Prompt chỉ dẫn chi tiết của lệnh:" Margin="0,0,0,5" Foreground="#888888"/>
                                            <TextBox Grid.Row="1" x:Name="CommandPromptTextBox" TextWrapping="Wrap" AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" FontSize="13" Background="#1E1E1E" BorderBrush="#333333"/>
                                        </Grid>

                                        <Grid Grid.Row="3">
                                            <Button Content="⚡ Chạy Thực Thi (C#)" Click="OnRunCommandClick" Background="#512BD4" Width="170" HorizontalAlignment="Left"/>
                                            <Button Content="Lưu Lệnh Tác Nghiệp" Click="OnSaveCommandClick" Background="#107C41" Width="150" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
