{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AITask",
  "description": "Standard schema for Goal-driven Task nodes inside the DAG Task Graph",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "goalId": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"]
    },
    "payload": {
      "type": "object"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "required": ["id", "goalId", "title", "status"]
}
